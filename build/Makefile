.PHONY : src/audio_interfaces/audio_interfaces.o

# target to build an object file
src/audio_interfaces/audio_interfaces.cpp.o:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/acu_full_test.dir/build.make CMakeFiles/acu_full_test.dir/src/audio_interfaces/audio_interfaces.cpp.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/acu_full_test_shared.dir/build.make CMakeFiles/acu_full_test_shared.dir/src/audio_interfaces/audio_interfaces.cpp.o
.PHONY : src/audio_interfaces/audio_interfaces.cpp.o

src/audio_interfaces/audio_interfaces.i: src/audio_interfaces/audio_interfaces.cpp.i
