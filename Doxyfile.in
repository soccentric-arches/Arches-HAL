# Doxyfile.in — Arches HAL reference documentation
#
# Configured by CMake (see the `doc_doxygen` / `doc_doxygen_pdf` targets in
# CMakeLists.txt) into ${CMAKE_CURRENT_BINARY_DIR}/Doxyfile. Do not run
# doxygen directly against this file — the @...@ substitutions need CMake.
#
# Outputs: HTML (docs/html), LaTeX source for the PDF reference
# (docs/latex, built into docs/Arches-HAL-Reference.pdf by
# doc_doxygen_pdf), XML (docs/xml, for downstream tooling), and man pages
# (docs/man). CHM/Qt/Docset/RTF/Perl outputs are intentionally left off —
# they need Windows-only or otherwise-absent tooling this repo doesn't
# carry a dependency on.
#
# WARN_AS_ERROR is intentionally NO: most of the 35 modules don't have full
# Doxygen-style comments yet, so treating every missing \param/\brief as a
# build failure would break `make doc` repo-wide today. Flip it on only
# once comment coverage is actually there — see WARN_LOGFILE below to see
# what's missing without failing the build.

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
PROJECT_NAME            = "Arches HAL"
PROJECT_NUMBER          = @PROJECT_VERSION@
PROJECT_BRIEF           = "C++17 hardware abstraction and validation layer for the Jetson -- canonical proto/gRPC contract for the Arches fleet"
PROJECT_LOGO            =
OUTPUT_LANGUAGE         = English
BRIEF_MEMBER_DESC       = YES
REPEAT_BRIEF            = YES
ALWAYS_DETAILED_SEC     = NO
INLINE_INHERITED_MEMB   = YES
FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = @CMAKE_CURRENT_SOURCE_DIR@
STRIP_FROM_INC_PATH     = @CMAKE_CURRENT_SOURCE_DIR@/src
SHORT_NAMES             = NO
JAVADOC_AUTOBRIEF       = YES
QT_AUTOBRIEF            = NO
MULTILINE_CPP_IS_BRIEF  = NO
INHERIT_DOCS            = YES
SEPARATE_MEMBER_PAGES   = NO
TAB_SIZE                = 2
OPTIMIZE_OUTPUT_FOR_C   = NO
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
BUILTIN_STL_SUPPORT     = YES
CPP_CLI_SUPPORT         = NO
DISTRIBUTE_GROUP_DOC    = NO
GROUP_NESTED_COMPOUNDS  = NO
SUBGROUPING             = YES
TYPEDEF_HIDES_STRUCT    = NO
LOOKUP_CACHE_SIZE       = 2
NUM_PROC_THREADS        = 0

# ---------------------------------------------------------------------------
# Build / extraction — maximal: document everything, public or not
# ---------------------------------------------------------------------------
EXTRACT_ALL              = YES
EXTRACT_PRIVATE          = YES
EXTRACT_PRIV_VIRTUAL     = YES
EXTRACT_PACKAGE          = YES
EXTRACT_STATIC           = YES
EXTRACT_LOCAL_CLASSES    = YES
EXTRACT_LOCAL_METHODS    = YES
EXTRACT_ANON_NSPACES     = YES
RESOLVE_UNNAMED_PARAMS   = YES
HIDE_UNDOC_MEMBERS       = NO
HIDE_UNDOC_CLASSES       = NO
HIDE_FRIEND_COMPOUNDS    = NO
HIDE_IN_BODY_DOCS        = NO
INTERNAL_DOCS            = YES
CASE_SENSE_NAMES         = SYSTEM
HIDE_SCOPE_NAMES         = NO
HIDE_COMPOUND_REFERENCE  = NO
SHOW_HEADERFILE          = YES
SHOW_INCLUDE_FILES       = YES
SHOW_GROUPED_MEMB_INC    = YES
FORCE_LOCAL_INCLUDES     = NO
INLINE_INFO              = YES
SORT_MEMBER_DOCS         = YES
SORT_BRIEF_DOCS          = YES
SORT_MEMBERS_CTORS_1ST   = YES
SORT_GROUP_NAMES         = YES
SORT_BY_SCOPE_NAME       = YES
STRICT_PROTO_MATCHING    = NO
GENERATE_TODOLIST        = YES
GENERATE_TESTLIST        = YES
GENERATE_BUGLIST         = YES
GENERATE_DEPRECATEDLIST  = YES
ENABLED_SECTIONS         =
MAX_INITIALIZER_LINES    = 30
SHOW_USED_FILES          = YES
SHOW_FILES               = YES
SHOW_NAMESPACES          = YES
FILE_VERSION_FILTER      =
LAYOUT_FILE              =
CITE_BIB_FILES           =

# ---------------------------------------------------------------------------
# Warnings
# ---------------------------------------------------------------------------
QUIET                    = NO
WARNINGS                 = YES
WARN_IF_UNDOCUMENTED     = YES
WARN_IF_DOC_ERROR        = YES
WARN_IF_INCOMPLETE_DOC   = YES
WARN_NO_PARAMDOC         = YES
WARN_AS_ERROR            = NO
WARN_FORMAT              = "$file:$line: $text"
WARN_LOGFILE             = @CMAKE_CURRENT_BINARY_DIR@/docs/doxygen_warnings.log

# ---------------------------------------------------------------------------
# Output directory — everything (html/latex/xml/man) lands under here
# ---------------------------------------------------------------------------
OUTPUT_DIRECTORY          = @CMAKE_CURRENT_BINARY_DIR@/docs
CREATE_SUBDIRS             = NO
ALLOW_UNICODE_NAMES        = NO

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
INPUT                    = @CMAKE_CURRENT_SOURCE_DIR@/src \
                            @CMAKE_CURRENT_SOURCE_DIR@/tests \
                            @CMAKE_CURRENT_SOURCE_DIR@/protos \
                            @CMAKE_CURRENT_SOURCE_DIR@/docs \
                            @CMAKE_CURRENT_SOURCE_DIR@/CHANGELOG.md
INPUT_ENCODING           = UTF-8
FILE_PATTERNS            = *.h *.hpp *.hh *.cpp *.cc *.cxx *.proto *.dox *.md
RECURSIVE                = YES
EXCLUDE                  =
EXCLUDE_SYMLINKS         = YES
EXCLUDE_PATTERNS         = */build/* */build-*/* */_CPack_Packages/* */cmake-build-*/*
EXCLUDE_SYMBOLS          =
EXAMPLE_PATH             =
EXAMPLE_PATTERNS         = *
EXAMPLE_RECURSIVE        = NO
IMAGE_PATH               =
INPUT_FILTER             =
FILTER_PATTERNS          =
FILTER_SOURCE_FILES      = NO
FILTER_SOURCE_PATTERNS   =
USE_MDFILE_AS_MAINPAGE   =
# .proto isn't a language doxygen natively understands; mapping it onto the
# C++ parser is a best-effort so message/enum/service blocks and their
# leading comments still show up. Field-level RPC semantics won't be as
# clean as real C++ output — treat the proto pages as a browsable index of
# protos/, not a substitute for reading protos/registry/modules.yaml.
EXTENSION_MAPPING        = proto=C++

# ---------------------------------------------------------------------------
# Source browsing
# ---------------------------------------------------------------------------
SOURCE_BROWSER            = YES
INLINE_SOURCES            = YES
STRIP_CODE_COMMENTS       = NO
REFERENCED_BY_RELATION    = YES
REFERENCES_RELATION       = YES
REFERENCES_LINK_SOURCE    = YES
SOURCE_TOOLTIPS           = YES
USE_HTAGS                 = NO
VERBATIM_HEADERS          = YES
CLANG_ASSISTED_PARSING    = NO

# ---------------------------------------------------------------------------
# Alphabetical index
# ---------------------------------------------------------------------------
ALPHABETICAL_INDEX        = YES
IGNORE_PREFIX              =

# ---------------------------------------------------------------------------
# HTML output
# ---------------------------------------------------------------------------
GENERATE_HTML            = YES
HTML_OUTPUT               = html
HTML_FILE_EXTENSION       = .html
HTML_HEADER               =
HTML_FOOTER               =
HTML_STYLESHEET           =
HTML_EXTRA_STYLESHEET     =
HTML_EXTRA_FILES          =
HTML_COLORSTYLE           = AUTO_LIGHT
HTML_COLORSTYLE_HUE       = 210
HTML_COLORSTYLE_SAT       = 100
HTML_COLORSTYLE_GAMMA     = 80
HTML_TIMESTAMP            = YES
HTML_DYNAMIC_MENUS        = YES
HTML_DYNAMIC_SECTIONS     = YES
HTML_CODE_FOLDING         = YES
HTML_COPY_CLIPBOARD       = YES
HTML_INDEX_NUM_ENTRIES    = 100
GENERATE_DOCSET           = NO
GENERATE_HTMLHELP         = NO
GENERATE_QHP              = NO
GENERATE_ECLIPSEHELP      = NO
DISABLE_INDEX             = NO
GENERATE_TREEVIEW         = YES
FULL_SIDEBAR              = NO
ENUM_VALUES_PER_LINE      = 4
TREEVIEW_WIDTH            = 270
EXT_LINKS_IN_WINDOW       = NO
OBFUSCATE_EMAILS          = YES
HTML_FORMULA_FORMAT       = png
FORMULA_FONTSIZE          = 10
FORMULA_TRANSPARENT       = YES
USE_MATHJAX               = NO
SEARCHENGINE              = YES
SERVER_BASED_SEARCH       = NO
EXTERNAL_SEARCH           = NO
SEARCHENGINE_URL          =
SEARCHDATA_FILE           = searchdata.xml
EXTERNAL_SEARCH_ID        =
EXTRA_SEARCH_MAPPINGS     =

# ---------------------------------------------------------------------------
# LaTeX output (source for the PDF reference — built by doc_doxygen_pdf)
# ---------------------------------------------------------------------------
GENERATE_LATEX            = YES
LATEX_OUTPUT               = latex
LATEX_CMD_NAME             = latex
MAKEINDEX_CMD_NAME         = makeindex
LATEX_MAKEINDEX_CMD        = makeindex
COMPACT_LATEX              = NO
PAPER_TYPE                 = a4
EXTRA_PACKAGES             =
LATEX_HEADER               =
LATEX_FOOTER                =
LATEX_EXTRA_FILES          =
PDF_HYPERLINKS             = YES
USE_PDFLATEX                = YES
LATEX_BATCHMODE             = YES
LATEX_HIDE_INDICES          = NO
LATEX_SOURCE_CODE           = YES
LATEX_BIB_STYLE             = plain
LATEX_TIMESTAMP             = YES
LATEX_EMOJI_DIRECTORY       =

# ---------------------------------------------------------------------------
# Other output formats
# ---------------------------------------------------------------------------
GENERATE_RTF               = NO
GENERATE_MAN               = YES
MAN_OUTPUT                  = man
MAN_EXTENSION                = .3
MAN_SUBDIR                  =
MAN_LINKS                   = YES
GENERATE_XML                = YES
XML_OUTPUT                   = xml
XML_PROGRAMLISTING           = YES
XML_NS_MEMB_FILE_SCOPE       = YES
GENERATE_DOCBOOK            = NO
GENERATE_AUTOGEN_DEF         = NO
GENERATE_PERLMOD            = NO

# ---------------------------------------------------------------------------
# Preprocessor
# ---------------------------------------------------------------------------
ENABLE_PREPROCESSING       = YES
MACRO_EXPANSION             = YES
EXPAND_ONLY_PREDEF           = NO
SEARCH_INCLUDES              = YES
INCLUDE_PATH                 = @CMAKE_CURRENT_SOURCE_DIR@/src
INCLUDE_FILE_PATTERNS        =
PREDEFINED                   = __cplusplus=201703L
EXPAND_AS_DEFINED             =
SKIP_FUNCTION_MACROS          = YES

# ---------------------------------------------------------------------------
# External references — emit a tagfile so sibling repos (Client, Server)
# can eventually cross-link into this repo's generated docs.
# ---------------------------------------------------------------------------
TAGFILES                    =
GENERATE_TAGFILE             = @CMAKE_CURRENT_BINARY_DIR@/docs/arches_hal.tag
ALLEXTERNALS                 = NO
EXTERNAL_GROUPS               = YES
EXTERNAL_PAGES                = YES

# ---------------------------------------------------------------------------
# Dot / Graphviz — every relation graph Doxygen can produce through dot is
# turned on:
#   - CLASS_GRAPH            inheritance graph per class
#   - COLLABORATION_GRAPH    usage/composition/aggregation graph per class
#   - DOT_UML_DETAILS        UML association labels + multiplicities on the
#                             above two, not just boxes
#   - GROUP_GRAPHS           module/@defgroup dependency graph
#   - TEMPLATE_RELATIONS     template <-> instantiation relations
#   - INCLUDE_GRAPH          what a file #includes
#   - INCLUDED_BY_GRAPH      what #includes a file
#   - CALL_GRAPH             what a function calls
#   - CALLER_GRAPH           what calls a function
#   - GRAPHICAL_HIERARCHY    whole-tree class hierarchy graph
#   - DIRECTORY_GRAPH        directory dependency graph (src/<module>_lib
#                             <-> src/<module>_lib via #include, plus
#                             lib_base/platform_arches/stm32_transport)
# All rendered as clickable/zoomable inline SVG (INTERACTIVE_SVG) rather
# than static PNG.
# ---------------------------------------------------------------------------
CLASS_DIAGRAMS              = YES
DIA_PATH                     =
HIDE_UNDOC_RELATIONS         = NO
HAVE_DOT                     = YES
DOT_NUM_THREADS              = 0
CLASS_GRAPH                  = YES
COLLABORATION_GRAPH          = YES
GROUP_GRAPHS                 = YES
UML_LOOK                     = YES
UML_LIMIT_NUM_FIELDS         = 50
DOT_UML_DETAILS              = YES
DOT_WRAP_THRESHOLD           = 17
TEMPLATE_RELATIONS           = YES
INCLUDE_GRAPH                = YES
INCLUDED_BY_GRAPH            = YES
CALL_GRAPH                   = YES
CALLER_GRAPH                 = YES
GRAPHICAL_HIERARCHY          = YES
DIRECTORY_GRAPH              = YES
DIR_GRAPH_MAX_DEPTH          = 5
DOT_IMAGE_FORMAT             = svg
INTERACTIVE_SVG              = YES
DOT_PATH                     =
DOTFILE_DIRS                 =
MSCFILE_DIRS                 =
DIAFILE_DIRS                 =
PLANTUML_JAR_PATH            =
PLANTUML_INCLUDE_PATH        =
DOT_GRAPH_MAX_NODES          = 200
MAX_DOT_GRAPH_DEPTH          = 0
DOT_TRANSPARENT              = NO
DOT_MULTI_TARGETS            = YES
GENERATE_LEGEND              = YES
DOT_CLEANUP                  = YES
